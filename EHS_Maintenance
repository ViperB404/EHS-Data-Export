            )


            pyautogui.write(
                filename,
                interval=0.02
            )


            time.sleep(
                0.5
            )


            print(
                "Saving file..."
            )


            pyautogui.press(
                "enter"
            )


            time.sleep(
                3
            )


            # =================================================
            # VERIFY PDF WAS ACTUALLY SAVED
            # =================================================

            pdf_saved = verify_saved_pdf(
                output_file,
                timeout_seconds=30
            )


            # =================================================
            # FAIL-SAFE
            # =================================================

            if not pdf_saved:

                print()
                print(
                    "==================================================="
                )

                print(
                    "FAIL-SAFE ACTIVATED"
                )

                print(
                    "==================================================="
                )

                print(
                    "The expected PDF was not found."
                )

                print(
                    "The script will STOP to prevent additional"
                )

                print(
                    "reports from being processed."
                )

                print()

                print(
                    f"Expected filename:"
                )

                print(
                    f"  {filename}"
                )

                print()

                print(
                    f"Expected location:"
                )

                print(
                    f"  {output_file}"
                )


                # ------------------------------------------------
                # RECORD FAILURE
                # ------------------------------------------------

                with FAILED_LOG.open(
                    "a",
                    encoding="utf-8"
                ) as failure_log:

                    failure_log.write(
                        f"Action Form: {report_id}\n"
                        f"Record GUID: {record_guid}\n"
                        f"Expected filename: {filename}\n"
                        f"Expected path: {output_file}\n"
                        f"Error: PDF was not found after save operation.\n"
                        f"{'-' * 60}\n"
                    )


                print()
                print(
                    "Failure recorded in:"
                )

                print(
                    f"  {FAILED_LOG}"
                )


                # ------------------------------------------------
                # HARD STOP
                # ------------------------------------------------

                raise SaveVerificationError(
                    "FAIL-SAFE: Expected PDF was not found. "
                    "The download process has been stopped."
                )


            # =================================================
            # SUCCESS
            # =================================================

            print()
            print(
                "SUCCESS!"
            )


            print(
                f"Saved: "
                f"{output_file}"
            )


            successful += 1


            existing_pdfs.add(
                filename
            )


            # =================================================
            # RETURN TO EHS
            # =================================================

            print()
            print(
                "Returning to browser..."
            )


            pyautogui.hotkey(
                "alt",
                "tab"
            )


            time.sleep(
                1
            )


            # =================================================
            # RESTORE 200 PER PAGE
            #
            # EHS may reset the grid to 20 rows when returning.
            # =================================================

            print()
            print(
                "Checking report list pagination..."
            )


            try:

                show_control = (
                    page.locator(
                        "a.dropdown-toggle"
                    )
                    .filter(
                        has_text="Show"
                    )
                    .first
                )


                if show_control.is_visible():

                    show_control.click()

                    time.sleep(
                        0.5
                    )


                    show_200 = page.get_by_text(
                        "Show 200 Per Page",
                        exact=True
                    )


                    if show_200.is_visible():

                        show_200.click()

                        page.wait_for_timeout(
                            2000
                        )


                        print(
                            "Restored 200 reports per page."
                        )

            except (
                PlaywrightError,
                PlaywrightTimeoutError
            ):

                print(
                    "Could not automatically restore "
                    "200 reports per page."
                )


        # =====================================================
        # FAIL-SAFE EXCEPTION
        # =====================================================

        except SaveVerificationError:

            print()
            print(
                "==================================================="
            )

            print(
                "DOWNLOAD PROCESS STOPPED"
            )

            print(
                "==================================================="
            )

            print(
                "The fail-safe detected that the expected "
                "PDF was not saved."
            )

            print()

            print(
                "No additional reports will be processed."
            )

            print()

            raise


        # =====================================================
        # NORMAL REPORT FAILURE
        # =====================================================

        except (
            PlaywrightError,
            PlaywrightTimeoutError,
            RuntimeError
        ) as report_error:


            failed += 1


            print()
            print(
                "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
            )


            print(
                "REPORT FAILED"
            )


            print(
                "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
            )


            print(
                f"Action Form:   "
                f"{report_id}"
            )


            print(
                f"Record GUID:   "
                f"{record_guid}"
            )


            print(
                f"Error:         "
                f"{report_error}"
            )


            # =================================================
            # FAILURE LOG
            # =================================================

            with FAILED_LOG.open(
                "a",
                encoding="utf-8"
            ) as failure_log:

                failure_log.write(
                    f"Action Form: {report_id}\n"
                    f"Record GUID: {record_guid}\n"
                    f"Error: {report_error}\n"
                    f"{'-' * 60}\n"
                )


            print()
            print(
                "Failure recorded in:"
            )

            print(
                FAILED_LOG
            )


            # =================================================
            # RETURN TO BROWSER
            # =================================================

            print()
            print(
                "Attempting to return to browser..."
            )


            try:

                pyautogui.hotkey(
                    "alt",
                    "tab"
                )

                time.sleep(
                    1
                )

            except OSError:

                pass


        # ====================================================
        # PROGRESS
        # ====================================================

        print()

        print(
            f"Progress: "
            f"{successful + failed}/"
            f"{len(reports_to_download)} "
            f"processed this run | "
            f"Successful: {successful} | "
            f"Skipped: {skipped} | "
            f"Failed: {failed}"
        )


    # ========================================================
    # COMPLETE
    # ========================================================

    print()
    print(
        "==================================================="
    )


    print(
        "DOWNLOAD RUN COMPLETE"
    )


    print(
        "==================================================="
    )


    print()

    print(
        f"Total Action Forms: "
        f"{total_reports}"
    )


    print(
        f"Successful:         "
        f"{successful}"
    )


    print(
        f"Skipped:            "
        f"{skipped}"
    )


    print(
        f"Failed:             "
        f"{failed}"
    )


    if failed > 0:

        print()
        print(
            "Failed reports were recorded here:"
        )

        print(
            FAILED_LOG
        )

    else:

        print()
        print(
            "No reports failed."
        )


    print()

    print(
        "Check your Downloads folder for the PDFs."
    )


    print()

    input(
        "Press ENTER to close..."
    )


    browser.close()
