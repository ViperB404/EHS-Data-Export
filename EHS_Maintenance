def toggle_pause():
    global paused

    if not paused:

        paused = True

        print()
        print("===================================================")
        print("PAUSED")
        print("Press F8 to resume.")
        print("===================================================")

    else:

        paused = False

        print()
        print("===================================================")
        print("RESUMING IN 5 SECONDS...")
        print("===================================================")

        for resume_seconds in range(5, 0, -1):

            print(
                f"  {resume_seconds}..."
            )

            time.sleep(1)

        print()
        print("Continuing...")


def request_stop():
    global stop_requested

    stop_requested = True

    print()
    print("===================================================")
    print("STOP REQUESTED")
    print("The current report will finish, then the script will stop.")
    print("===================================================")


keyboard.add_hotkey(
