)

# ============================================================
# CUSTOM EXCEPTION
# ============================================================

class SaveVerificationError(Exception):
    """Raised when the expected PDF cannot be verified."""
pass

# ============================================================
# PAUSE / STOP CONTROL
# ============================================================

paused = False
stop_requested = False


def toggle_pause():
    global paused

    if not paused:

        paused = True

        print()
        print("===================================================")
        print("PAUSED")
        print("Press F8 to resume.")
        print("===================================================")

    else:

        paused = False

        print()
        print("===================================================")
        print("RESUMING IN 5 SECONDS...")
        print("===================================================")

        for resume_seconds in range(5, 0, -1):

            print(
                f"  {resume_seconds}..."
            )

            time.sleep(1)

        print()
        print("Continuing...")


def request_stop():
    global stop_requested

    stop_requested = True

    print()
    print("===================================================")
    print("STOP REQUESTED")
    print("The current report will finish, then the script will stop.")
    print("===================================================")


keyboard.add_hotkey(
    "f8",
    toggle_pause
)

keyboard.add_hotkey(
    "f9",
    request_stop
)


# ============================================================
# SETTINGS
# ============================================================

EHS_REPORT_URL = "YOUR_URL_HERE"
# None = process all missing reports
# 1 = process first missing report only
# 5 = process first 5 missing reports

TEST_LIMIT = None

# Folder where PDFs will be saved
DOWNLOAD_DIR = (
