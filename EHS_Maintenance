# ============================================================
# VERIFY SAVED PDF
# ============================================================

def verify_saved_pdf(
    output_file,
    timeout_seconds=30
):
    """
    Verify that the expected PDF was actually saved.

    The PDF must:
        1. Exist at the exact expected path.
        2. Have a file size greater than zero.
    """

    print()
    print("Verifying saved PDF...")

    print(
        f"Expected file: "
        f"{output_file.name}"
    )

    for elapsed_seconds in range(
        1,
        timeout_seconds + 1
    ):

        if output_file.exists():

            try:

                file_size = (
                    output_file.stat().st_size
                )

            except OSError as file_error:

                print()
                print(
                    "File appeared, but its size "
                    "could not be checked."
                )

                print(
                    f"Error: {file_error}"
                )

                time.sleep(1)

                continue

            # ------------------------------------------------
            # FILE IS NOT EMPTY
            # ------------------------------------------------

            if file_size > 0:

                print()
                print(
                    "PDF SAVE VERIFIED."
                )

                print(
                    f"Filename: "
                    f"{output_file.name}"
                )

                print(
                    f"File size: "
                    f"{file_size:,} bytes"
                )

                return True

        # ----------------------------------------------------
        # STATUS
        # ----------------------------------------------------

        if elapsed_seconds % 5 == 0:

            print(
                f"  PDF not detected yet... "
                f"{elapsed_seconds}/"
                f"{timeout_seconds} seconds"
            )

        time.sleep(1)

    print()
    print(
        "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
    )

    print(
        "PDF SAVE VERIFICATION FAILED"
    )

    print(
        "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
    )

    print(
        "Expected file was not found:"
    )

    print(
        f"  {output_file}"
    )

    return False


